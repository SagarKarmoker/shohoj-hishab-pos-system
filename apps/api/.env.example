# Database Configuration
# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:password@localhost:5432/shohoj_hishab?schema=public"

# Server Configuration
PORT=8080

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Email Configuration (SMTP)
# For Gmail: Use App Password (https://support.google.com/accounts/answer/185833)
# For other providers: Get SMTP credentials from your email service
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM="Shohoj Hishab <noreply@shohojhishab.com>"

# Frontend URL (for email links)
FRONTEND_URL=http://localhost:5000

# Token Expiry (in milliseconds)
EMAIL_VERIFICATION_EXPIRES=86400000  # 24 hours
PASSWORD_RESET_EXPIRES=3600000       # 1 hour
