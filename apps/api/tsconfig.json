{
  "extends": "@shohoj-hishab/typescript-config/nest",
  "compilerOptions": {
    "baseUrl": "./",
    "outDir": "./dist",
    "rootDir": ".",
    "paths": {
      "@/*": ["src/*"],
      "@prisma/client": ["prisma/generated/client/client.ts"]
    }
  },
  "include": ["src/**/*", "prisma/generated/**/*"],
  "exclude": ["node_modules", "dist", "test"]
}